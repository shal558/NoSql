// =====================================================
// ЗАДАНИЕ 7. Создание и безопасное удаление тестового узла
// =====================================================

// Создать тестовый узел
CREATE (:Temp {id: 999, note: "delete-me"});

// Удалить его (DETACH DELETE)
MATCH (n:Temp {id: 999})
DETACH DELETE n;

// Проверить, что удалён (должно вернуть 0)
MATCH (n:Temp {id: 999})
RETURN count(n) AS remaining;
