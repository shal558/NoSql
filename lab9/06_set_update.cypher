// =====================================================
// ЗАДАНИЕ 6. Изменение свойств узла и отношения (SET)
// =====================================================

// Изменить свойство узла
MATCH (s:Student {id: 1})
SET s.year = 3
RETURN s;

// Добавить/изменить свойство отношения
MATCH (s:Student {id: 1})-[r:STUDIES]->(c:Course {id: 101})
SET r.grade = "A"
RETURN s.name, r.semester, r.grade, c.title;
